# ─────────────────────────────────────────────────────────────────────────────
# Production .env — copy to .env on the server. NEVER commit the real file.
# Used by docker-compose.prod.yml (env_file). Hostnames are the compose network
# names (postgres / redis), not localhost.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=fintech-cron-monitor

# --- datastores (compose network) -------------------------------------------
POSTGRES_USER=cronmon
POSTGRES_PASSWORD=            # generate: openssl rand -hex 24
POSTGRES_DB=cronmon
DATABASE_URL=postgres://cronmon:CHANGE_ME@postgres:5432/cronmon   # password must match POSTGRES_PASSWORD
REDIS_URL=redis://redis:6379

# --- edge / TLS ------------------------------------------------------------
API_DOMAIN=cron-api.ismartghana.com        # A record → this server's IP; Caddy gets the cert
# Browser origin(s) allowed to call the API — your Vercel dashboard URL(s).
CORS_ALLOWED_ORIGINS=https://<your-project>.vercel.app

# --- auth (required in production) ----------------------------------------
AUTH_ENABLED=true
JWT_SECRET=                   # >= 16 chars — openssl rand -hex 32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@ismartghana.com
BOOTSTRAP_ADMIN_PASSWORD=     # strong; change after first login

# --- credential encryption (required in production) ----------------------
CREDENTIAL_ENCRYPTION_KEY=    # base64 32 bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

INSTANCE_ID=prod-1

# --- scheduler / incident tuning (defaults are fine) --------------------
SCHEDULER_HEARTBEAT_GRACE_MS=30000
INCIDENT_RECOVERY_STREAK=2
FLAPPING_THRESHOLD=4
FLAPPING_WINDOW_MINUTES=10

# --- watchdog (independent alert path — do NOT point at this API) -------
WATCHDOG_EXTERNAL_ENDPOINT=   # e.g. a Slack incoming webhook, or an external uptime service's push URL

# --- email (Gmail) ------------------------------------------------------
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASSWORD=                # Gmail App Password
ALERT_EMAIL_FROM=             # = SMTP_USER (Gmail rewrites anything else)

# --- SMS gateway (iSmartGhana) ---------------------------------------
SMS_GATEWAY_URL=http://157.180.53.137:5665/api/SendSms
SMS_API_ID=
SMS_API_PASSWORD=
SMS_SENDER_ID=Operation
SMS_TYPE=P
SMS_ENCODING=T
SMS_VALIDITY_SECONDS=1800

# --- digest -----------------------------------------------------------
SMS_DIGEST_ENABLED=true
SMS_DIGEST_INTERVAL_MINUTES=30
SMS_DIGEST_TIMEZONE=Africa/Accra
SMS_DIGEST_LABEL=iSmart Health
# Recipients live in the notification_contacts table (API), not here.

# --- push (Firebase) — put the JSON at ./secrets/fcm.json on the server -
FCM_SERVICE_ACCOUNT_FILE=/app/secrets/fcm.json
FCM_DEFAULT_TOPIC=cron-alerts
ALERT_DEFAULT_CHANNELS=WEBHOOK,PUSH
ALERT_DEFAULT_RECIPIENT=ops

# --- optional --------------------------------------------------------
ANTHROPIC_API_KEY=
STATUS_PAGE_ENABLED=true
WEBHOOK_SIGNING_SECRET=
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=

# --- MPSMS target seed (npm run seed:mpsms) ------------------------
MPSMS_BASE_URL=https://vend.ismartghana.com/api/topup
MPSMS_ACCESSCODE=
MPSMS_CLIENTCODE=
MPSMS_TRACKID=
