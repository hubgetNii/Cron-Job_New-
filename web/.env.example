# The dashboard reaches the API through Vite's dev proxy (/api -> :3000), so
# nothing is required here for local dev.

# Point the dev proxy somewhere other than localhost:3000:
# VITE_API_TARGET=http://localhost:3000

# Or bypass the proxy and call the API directly (needs CORS on the API):
# VITE_API_URL=https://cron-monitor.example.com/api/v1
