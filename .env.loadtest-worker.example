# Load-test worker environment. Copy to .env.loadtest-worker and `chmod 600` it.
# This file holds the key that decrypts target credentials — keep it off git and off shared drives.

NODE_ENV=production
LOG_LEVEL=info
INSTANCE_ID=loadtest-worker-1

# The monitor's Postgres, reached over a PRIVATE path (WireGuard/VPC/SSH tunnel) with TLS.
# Use a database role limited to what the worker needs; do not reuse the admin role.
DATABASE_URL=postgres://loadtest_worker:CHANGE_ME@10.0.0.2:5432/cronmon?sslmode=require

# Required by the shared config schema; the worker never connects to Redis.
REDIS_URL=redis://127.0.0.1:6379

# Same key the API uses, so the worker can decrypt target credentials.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME

# Nothing runs until this is true. Flip it only when you intend the worker to take runs.
LOAD_TEST_ENABLED=false

# Hosts this worker may ever send load to (the safety gate also checks each target).
LOAD_TEST_SANDBOX_HOSTS=stgdeveloper-api.ismartghana.com
# Do NOT blank or remove the production host list: it is how production hosts are recognised
# and refused. The built-in default (api / gateway / vend .ismartghana.*) is correct; only
# extend it if iSmart adds production hostnames.
# LOAD_TEST_PRODUCTION_HOSTS=api.ismartghana.com,gateway.ismartghana.org,vend.ismartghana.com

# Ceilings stay conservative until iSmart confirms the sandbox's rate limits.
# Format CLASS:rps/vus/seconds. These are the built-in defaults, shown so you can see them:
# LOAD_TEST_CEILINGS=MOCK:5000/2000/3600,SANDBOX:25/100/1800,STAGING:25/100/1800,PRODUCTION:2/5/300
