# ─────────────────────────────────────────────────────────────────────────────
# FinTech Cron Monitor — environment configuration
# Copy to .env and fill in. NEVER commit .env. See vault: "Environment Configuration".
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=fintech-cron-monitor

# Datastores (host ports match docker-compose.yml: 5433 / 6380)
DATABASE_URL=postgres://cronmon:cronmon@localhost:5433/cronmon
REDIS_URL=redis://localhost:6380

# Browser origins allowed to call the API cross-origin (the dashboard when it's
# hosted separately, e.g. on Vercel). Comma-separated, or "*". Blank in local
# dev where the Vite proxy makes it same-origin. See docs/deployment.md.
CORS_ALLOWED_ORIGINS=

# Auth / tokens (Phase 9 — placeholders for now)
# Authentication (Phase 9). AUTH_ENABLED=false bypasses auth — local dev only,
# refused in production. Set a JWT_SECRET (>=16 chars) when auth is on.
AUTH_ENABLED=true
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# First-run: if the users table is empty, an ADMIN is created from these.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Rate limiting (Phase 9, Redis-backed)
RATE_LIMIT_POINTS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_POINTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Credential envelope encryption
# Local key-encryption key (base64, 32 bytes) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave blank in dev/test to use the built-in insecure dev key. Required in production.
CREDENTIAL_ENCRYPTION_KEY=
ENCRYPTION_KMS_KEY_ID=      # Phase 9 — KMS-backed key id (replaces the local key)

# Process identity (distributed locks, heartbeats, job records)
INSTANCE_ID=local-1

# Scheduler / cron engine (Phase 5)
SCHEDULER_LOCK_TTL_MS=15000
SCHEDULER_HEARTBEAT_INTERVAL_MS=10000
SCHEDULER_HEARTBEAT_GRACE_MS=30000
MAX_GLOBAL_CONCURRENT_CHECKS=50
DEFAULT_CHECK_TIMEOUT_MS=8000

# Incident state machine (Phase 6)
INCIDENT_RECOVERY_STREAK=2
FLAPPING_THRESHOLD=4
FLAPPING_WINDOW_MINUTES=10

# Notification channels (Phase 7) — a channel with no transport configured logs instead of sending
# Email: set SMTP_SERVICE (a nodemailer well-known name: gmail / outlook365 / …)
# OR SMTP_HOST + SMTP_PORT. The digest email is a full per-system status report.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=          # true for port 465; leave blank to infer from the port
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=cron-monitor@ismartghana.com
ALERT_EMAIL_TO=       # fallback recipient for per-event email alerts
ALERT_SMS_TO=

# SMS gateway (iSmartGhana bulk SMS) — a GET with credentials in the query
# string. Unset → SMS is logged only. api_password is redacted from logs.
SMS_GATEWAY_URL=http://157.180.53.137:5665/api/SendSms
SMS_API_ID=
SMS_API_PASSWORD=
SMS_SENDER_ID=Operation
SMS_TYPE=P
SMS_ENCODING=T
SMS_VALIDITY_SECONDS=1800
SMS_CALLBACK_URL=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=

# SMS is a DIGEST channel, not an event stream (docs/sms-digest-notifications.md).
# A job snapshots overall system health every SMS_DIGEST_INTERVAL_MINUTES and
# notifies only when the overall level changes (HEALTHY/DEGRADED/CRITICAL) — or
# every run for a contact flagged digest_every_run (e.g. the email full-status).
#
# Recipients (SMS numbers + email addresses) live in the notification_contacts
# table — manage via GET/POST/PUT/DELETE /api/v1/notification-contacts.
# SMS_DIGEST_RECIPIENTS is an additional env-only SMS list (merged in).
SMS_DIGEST_ENABLED=true
SMS_DIGEST_INTERVAL_MINUTES=30
SMS_DIGEST_RECIPIENTS=
SMS_DIGEST_TIMEZONE=Africa/Accra
SMS_DIGEST_LABEL=iSmart Health

# On top of the state-change SMS, send the full platform status to every SMS
# contact on a fixed cadence (default hourly) regardless of change — the SMS
# counterpart of the every-run email.
SMS_STATUS_BROADCAST_ENABLED=true
SMS_STATUS_INTERVAL_MINUTES=60

ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=

# Firebase Cloud Messaging — the PUSH channel. Download a service-account JSON
# from the Firebase console (Project settings → Service accounts → Generate new
# private key) and point at it. Unset → PUSH alerts are logged only.
FCM_SERVICE_ACCOUNT_FILE=
# Topic that plain recipients (e.g. the default "ops") deliver to. Subscribe
# devices to it, or send to "/topics/<name>" directly from an escalation tier.
FCM_DEFAULT_TOPIC=cron-alerts

# Channels the incident engine auto-sends to (open / degrade / recover / flap).
# Comma-separated; each must be a valid alert_channel. "WEBHOOK,PUSH" fans out.
ALERT_DEFAULT_CHANNELS=WEBHOOK
ALERT_DEFAULT_RECIPIENT=ops

ALERT_SUPPRESSION_WINDOW_MINUTES=30

# Independent watchdog alert path (Phase 5 — must NOT depend on the primary alert engine)
WATCHDOG_EXTERNAL_ENDPOINT=

# AI intelligence (Phase 10) — ALL AI output is advisory. With no API key the
# AI analysis endpoints return "not configured"; statistical anomaly detection
# still runs (it never calls an LLM).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_ENABLED=true
ANOMALY_BASELINE_DAYS=30
ANOMALY_Z_THRESHOLD=3
ANOMALY_MIN_BASELINE_SAMPLES=30

# Reporting & status page (Phase 11)
SLA_REPORT_INTERVAL_MINUTES=30
STATUS_PAGE_ENABLED=true

# MPSMS airtime vendor. `npm run seed:mpsms` registers the /connect target
# (Basic auth: username = access code, password = client code from the MPSMS
# Console). `npm run seed:mpsms-check` registers the /check transaction-status
# target (OAUTH2: Bearer token minted by /connect). Leave blank if not
# integrating with MPSMS.
MPSMS_BASE_URL=https://vend.ismartghana.com/api/topup
MPSMS_ACCESSCODE=
MPSMS_CLIENTCODE=
MPSMS_TRACKID=
# A stable, already-completed transaction reference for the /check health probe.
MPSMS_CHECK_REFERENCE=
